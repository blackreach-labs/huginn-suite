        "visible": false
      },
      {
        "label": "Password:",
        "controls": [
          {"type": "lineedit", "name": "http_password", "placeholder": "Password", "password": true, "stretch": true, "visible": false}
        ],
        "visible": false
      },
      {
        "label": "Credentials:",
        "controls": [
          {"type": "button", "name": "http_cred_manager_btn", "text": "📋 Load from Credential Manager", "stretch": true, "visible": false}
        ],
        "visible": false
