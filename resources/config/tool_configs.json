          {"type": "combobox", "name": "wordlist_size", "items": ["Small", "Medium", "Large"], "width": 120, "default": "Medium", "visible": false}
        ],
        "visible": false
      },
      {
        "label": "Extensions:",
        "controls": [
          {"type": "checkable_combobox", "name": "ext_web", "group_label": "Web", "items": [".php", ".php3", ".php4", ".php5", ".phtml", ".asp", ".aspx", ".ascx", ".ashx", ".jsp", ".jspx", ".do", ".action"], "checked_items": [".php"], "width": 170},
          {"type": "checkable_combobox", "name": "ext_frontend", "group_label": "Frontend", "items": [".html", ".htm", ".xhtml", ".js", ".jsx", ".json"], "checked_items": [".html"], "width": 198},
          {"type": "checkable_combobox", "name": "ext_config", "group_label": "Config", "items": [".env", ".config", ".conf", ".ini"], "checked_items": [], "width": 175},
          {"type": "checkable_combobox", "name": "ext_backup", "group_label": "Backup", "items": [".bak", ".old", ".tmp", ".backup"], "checked_items": [], "width": 190}
        ],
        "add_stretch": true,
        "visible": false
      },
      {
        "label": "Wordlist:",
        "controls": [
          {"type": "combobox", "name": "http_wordlist", "items": [], "stretch": true, "visible": true, "default_file": "common.txt"}
        ],
        "visible": false
      },
      {
        "label": "Auth Method:",
        "controls": [
          {"type": "combobox", "name": "http_auth_method", "items": ["None", "Basic Auth"], "width": 150, "default": "None"}
